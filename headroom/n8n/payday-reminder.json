    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config (now)').item.json.appUrl }}/api/activity",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-callback-secret", "value": "={{ $('Config (now)').item.json.callbackSecret }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ profileId: $('Reminder message').item.json.profileId, kind: 'reminder_sent', title: 'Friday reminder sent by WhatsApp', detail: String($('Reminder message').item.json.message || '').slice(0, 60), source: 'n8n' }) }}",
        "options": { "timeout": 5000 }
      },
      "id": "7c2e1b20-0012-4d2f-8b02-reminder0012",
      "name": "Log to Headroom (now)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 400]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"ok\": true\n}",
        "options": {}
      },
      "id": "7c2e1b20-0013-4d2f-8b02-reminder0013",
      "name": "Respond ok (now)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1320, 400]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"ok\": false,\n  \"error\": \"bad secret\"\n}",
        "options": { "responseCode": 401 }
      },
      "id": "7c2e1b20-0014-4d2f-8b02-reminder0014",
      "name": "Respond 401 (now)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [660, 600]
    }
  ],
