        "to": "={{ $json.to.replace('whatsapp:', '') }}",
        "toWhatsapp": true,
        "message": "={{ $json.message }}",
        "options": {}
      },
      "id": "7c2e1b20-0011-4d2f-8b02-reminder0011",
      "name": "Send WhatsApp (now)",
